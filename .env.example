# ==========================================
# EventGraph AI — Environment Configuration
# ==========================================

# Google AI Studio / Gemini API Key (Get from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Database URL
# Default SQLite (Zero setup local run):
DATABASE_URL=sqlite:///./eventgraph.db
# Or Google Cloud SQL PostgreSQL for Production:
# DATABASE_URL=postgresql://user:password@/eventgraph?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME

# Google Maps API (Optional for map integration)
GOOGLE_MAPS_API_KEY=

# Firebase / Tenant Setting
FIREBASE_PROJECT_ID=
DEFAULT_TENANT_ID=tenant-demo-hub
ENVIRONMENT=development
